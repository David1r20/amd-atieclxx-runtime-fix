<Window x:Class="AtieclxxSetup.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AMD atieclxx Fix" Width="920" Height="634" MinWidth="780" MinHeight="590"
    FontFamily="Segoe UI" FontSize="13" Background="{StaticResource BackgroundBrush}"
    WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip"
    Foreground="{StaticResource MainText}">
  <Border BorderBrush="#30414D" BorderThickness="1" Background="{StaticResource BackgroundBrush}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="58"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="45"/>
      </Grid.RowDefinitions>
      <!-- Window toolbar -->
      <Border Grid.Row="0" Background="#111922" BorderBrush="#263440" BorderThickness="0 0 0 1"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid Margin="26 0 16 0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Background="#214B50" Width="30" Height="30" CornerRadius="9" Margin="0 0 11 0">
              <TextBlock Text="◆" Foreground="#9CF0E4" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
            </Border>
            <TextBlock Text="RADEON " Foreground="#F4F7FA" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text="/ ATIECLXX FIX" Foreground="#9BAEBB" FontSize="14" VerticalAlignment="Center" />
            <Border Background="#223D3E" Padding="10 4" CornerRadius="6" Margin="13 0 0 0" VerticalAlignment="Center">
              <TextBlock Text="BETA 0.3.2" Foreground="#8ED8CF" FontWeight="SemiBold" FontSize="10"/>
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="—" Width="36" Height="30" Background="Transparent" Foreground="#B0C0CD" BorderThickness="0"
                    Cursor="Hand" FontSize="15" Click="Minimize_Click"/>
            <Button Content="×" Width="36" Height="30" Background="Transparent" Foreground="#DEE7ED" BorderThickness="0"
                    Cursor="Hand" FontSize="22" Click="Close_Click"/>
          </StackPanel>
        </Grid>
      </Border>
      <!-- Primary surface -->
      <Grid Grid.Row="1" Margin="32 26 32 19">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="20"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="16"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="16"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Heading -->
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Foreground="#7DDACF" FontSize="10" FontWeight="Bold" Text="DIAGNÓSTICO E PROTEÇÃO DO SSD"/>
            <TextBlock Text="Um driver sem gravações desnecessárias." FontWeight="SemiBold"
                       FontSize="25" Foreground="#F5F8FA" Margin="0 8 0 5"/>
            <TextBlock Text="Mantém o serviço Radeon ativo sem modificar os arquivos assinados da AMD."
                       Foreground="#A1B0BC" FontSize="12" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="TestWritesButton" Content="◉  Medir gravações" Style="{StaticResource GhostButton}"
                    Focusable="False" Click="TestWrites_Click" MinWidth="142" Margin="0 0 10 0"
                    Visibility="Collapsed"/>
            <Button x:Name="RefreshButton" Content="↻  Verificar novamente"
                    Style="{StaticResource GhostButton}" MinWidth="171" Focusable="False"
                    Click="Refresh_Click"/>
          </StackPanel>
        </Grid>
        <!-- Main status highlight -->
        <Border Grid.Row="2" Background="#192630" CornerRadius="13" Padding="21 19" BorderBrush="#31515A" BorderThickness="1">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Background="#264B4B" Width="52" Height="52" CornerRadius="14" Margin="0 0 19 0">
              <TextBlock x:Name="StatusSymbol" Text="◉" Foreground="#80DCD3" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="StatusTitle" Text="Verificando o sistema…" Foreground="#F4F9FA" FontWeight="SemiBold" FontSize="18"/>
              <TextBlock x:Name="StatusSubline" Text="Identificando o executável AMD e as gravações atuais." Foreground="#B3C3CD"
                         Margin="0 5 0 0" TextWrapping="Wrap" FontSize="12"/>
            </StackPanel>
            <Border Grid.Column="2" CornerRadius="7" Background="#294D4B" Padding="13 7" VerticalAlignment="Center">
              <TextBlock x:Name="StatusTag" Text="ANALISANDO" Foreground="#B3E9E3" FontSize="10" FontWeight="Bold"/>
            </Border>
          </Grid>
        </Border>
        <!-- Metrics -->
        <Grid Grid.Row="4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="11" Padding="15 15" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel>
              <TextBlock Text="DRIVER AMD" Foreground="#8DA2B1" FontSize="10" FontWeight="SemiBold"/>
              <TextBlock x:Name="DriverValue" Text="Verificando…" FontSize="16" FontWeight="SemiBold" Foreground="#EEF4F8" Margin="0 9 0 3"/>
              <TextBlock x:Name="DriverNote" Text="Hash SHA-256" Foreground="#8BA0AE" FontSize="10"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="11" Padding="15 15" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel>
              <TextBlock Text="PROCESSO AMD" Foreground="#8DA2B1" FontSize="10" FontWeight="SemiBold"/>
              <StackPanel Orientation="Horizontal" Margin="0 8 0 3">
                <TextBlock x:Name="WriteValue" Text="—" FontSize="18" FontWeight="SemiBold" Foreground="#EEF4F8"/>
                <TextBlock Text=" MB/s" Margin="3 5 0 0" Foreground="#A0B1BF" FontSize="10"/>
              </StackPanel>
              <TextBlock x:Name="WriteNote" Text="I/O do atieclxx" Foreground="#8BA0AE" FontSize="10" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="4" Background="{StaticResource SurfaceBrush}" CornerRadius="11" Padding="15 15" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel>
              <TextBlock Text="DISCO C: TOTAL" Foreground="#8DA2B1" FontSize="10" FontWeight="SemiBold"/>
              <StackPanel Orientation="Horizontal" Margin="0 8 0 3">
                <TextBlock x:Name="DiskValue" Text="—" FontSize="18" FontWeight="SemiBold" Foreground="#EEF4F8"/>
                <TextBlock Text=" MB/s" Margin="3 5 0 0" Foreground="#A0B1BF" FontSize="10"/>
              </StackPanel>
              <TextBlock x:Name="DiskNote" Text="Todas as gravações" Foreground="#8BA0AE" FontSize="10" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="6" Background="{StaticResource SurfaceBrush}" CornerRadius="11" Padding="15 15" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel>
              <TextBlock Text="SERVIÇO AMD" Foreground="#8DA2B1" FontSize="10" FontWeight="SemiBold"/>
              <TextBlock x:Name="ServiceValue" Text="Verificando…" FontSize="16" FontWeight="SemiBold" Foreground="#EEF4F8" Margin="0 9 0 3"/>
              <TextBlock x:Name="ServiceNote" Text="External Events" Foreground="#8BA0AE" FontSize="10" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Border>
        </Grid>
        <!-- Overview -->
        <Border Grid.Row="6" Background="#121A23" BorderBrush="#27343F" BorderThickness="1" CornerRadius="11" Padding="18 14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="1"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0 0 18 0" VerticalAlignment="Center">
              <TextBlock Text="Como funciona" Foreground="#EDF3F8" FontSize="13" FontWeight="SemiBold" Margin="0 0 8 0"/>
              <TextBlock TextWrapping="Wrap" Foreground="#A4B6C1" FontSize="11.5">
                O monitor aplica uma correção de seis bytes apenas na memória do processo AMD. O driver original permanece assinado e intacto.
              </TextBlock>
            </StackPanel>
            <Border Grid.Column="1" Background="#2A3946"/>
            <StackPanel Grid.Column="2" Margin="18 0 0 0" VerticalAlignment="Center">
              <TextBlock Text="Segurança" Foreground="#EDF3F8" FontSize="13" FontWeight="SemiBold" Margin="0 0 8 0"/>
              <TextBlock TextWrapping="Wrap" Foreground="#A4B6C1" FontSize="11.5">
                Instala somente em versões verificadas por hash. Requer autorização do Windows e permite desinstalação reversível.
              </TextBlock>
            </StackPanel>
          </Grid>
        </Border>
        <!-- Actions -->
        <Grid Grid.Row="7" Margin="0 19 0 0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Vertical" VerticalAlignment="Center">
            <TextBlock x:Name="ActivityText" Text="Lendo informações do driver…" Foreground="#9BB0C0" FontSize="11.5" TextWrapping="Wrap"/>
            <ProgressBar x:Name="BusyBar" Height="2" IsIndeterminate="True" BorderThickness="0"
                         Background="#22323A" Foreground="#78D9CF" Width="220" HorizontalAlignment="Left" Margin="0 8 0 0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="RemoveButton" Content="Desinstalar" Style="{StaticResource GhostButton}"
                    Click="Remove_Click" Margin="0 0 10 0" MinWidth="115" IsEnabled="False"/>
            <Button x:Name="InstallButton" Content="Instalar proteção" Style="{StaticResource PrimaryButton}"
                    Click="Install_Click" IsEnabled="False"/>
          </StackPanel>
        </Grid>
      </Grid>
      <!-- Footer -->
      <Border Grid.Row="2" Background="#101720" BorderBrush="#263440" BorderThickness="0 1 0 0">
        <Grid Margin="30 0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="Código aberto  ·  Sem telemetria  ·  Nenhum arquivo do driver substituído"
                     FontSize="10.5" Foreground="#8FA5B2" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="AMD ATIECLXX FIX  /  V0.3.2 PREVIEW"
                     FontSize="10" Foreground="#6B8493" VerticalAlignment="Center"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>